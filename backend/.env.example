# ========== Environment ==========
ENV=development            # development | production
DEBUG=true

# ========== Database ==========
# Dev (SQLite): sqlite:///./app.db
# Prod (Postgres): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# ========== JWT ==========
# IMPORTANT: ใช้ secrets.token_urlsafe(32) สร้างค่าใหม่ก่อน deploy production
SECRET_KEY=change-me-to-a-random-256-bit-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== CORS ==========
# comma-separated origins ที่อนุญาตให้เรียก API (ใช้เฉพาะ production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ========== PromptPay ==========
PROMPTPAY_ID=0000000000

# ========== Cache (optional) ==========
# REDIS_URL=redis://localhost:6379/0
