# ========== Environment ==========
ENV=development            # development | production
DEBUG=true

# ========== Database ==========
# เครื่องของหมิงรัน PostgreSQL อยู่ใน Docker — ต้องเปิด Docker Desktop ก่อนรัน backend
# ไม่งั้นจะขึ้น "connection refused ... port 5432"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edtech_db

# ========== JWT ==========
# IMPORTANT: ใช้ secrets.token_urlsafe(32) สร้างค่าใหม่ก่อน deploy production
SECRET_KEY=change-me-to-a-random-256-bit-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== CORS ==========
# หน้าเว็บที่อนุญาตให้เรียก API คั่นด้วยจุลภาค — 3000 คือ Next.js (web/)
# ชื่อตัวแปรคือ CORS_ORIGINS เท่านั้น (ยังรับชื่อเก่า CORS_ALLOW_ORIGINS ได้ด้วย)
# ตอน dev โค้ดจะปล่อย localhost ทุกพอร์ตให้อยู่แล้ว ค่านี้สำคัญตอน production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ========== Payment webhook ==========
# secret ที่เกตเวย์ใช้เซ็นข้อความ — ถ้าไม่ตั้ง /payments/webhook จะปฏิเสธทุก request
# PAYMENT_WEBHOOK_SECRET=

# ========== PromptPay ==========
PROMPTPAY_ID=0000000000

# ========== Cache (optional) ==========
# REDIS_URL=redis://localhost:6379/0
